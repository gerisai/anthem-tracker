{
  "name": "anthem-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "dev:login": "tsx --env-file=.env scripts/dev-login.ts",
    "user:role": "tsx --env-file-if-exists=.env scripts/user-role.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.2"
  }
}
