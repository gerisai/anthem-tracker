# Copy to .env for local development: cp .env.example .env
# Production values live in the Vercel project settings, never in this file.

# Local Postgres from docker-compose.yml (npm run db:up)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/anthem"
# Used by Prisma Migrate. Locally the same as DATABASE_URL; in production Neon's
# direct (non-pooled) connection string, while DATABASE_URL is the pooled one
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/anthem"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/anthem_shadow"
# Used by npm test; wiped before every test
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/anthem_test"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# GitHub OAuth app for localhost (see README: "Logging in locally")
GITHUB_ID=""
GITHUB_SECRET=""

# Optional: Google OAuth client for localhost
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
