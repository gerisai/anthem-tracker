// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Generated into generated/prisma (gitignored); import from '@/generated/prisma/client'
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Connection URLs live in prisma.config.ts (CLI) and lib/prisma.ts (app)
datasource db {
  provider = "postgresql"
}

// NextAuth schema
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  age           Int?
  bio           String?
  role          Role          @default(viewer)
  accounts      Account[]
  sessions      Session[]
  programs      Program[]
  fullprograms  FullProgram[]
}

// viewer: read-only (default for anyone who signs in)
// editor: creates services and songs, edits/deletes their own services
// admin: everything editors can, on any service
enum Role {
  viewer
  editor
  admin
}

model Song {
  id       String     @id @default(cuid())
  name     String
  type     String
  number   String?
  dates    DateTime[]
  programs Program[]
}

model Program {
  id          String        @id @default(cuid())
  songs       Song[]
  type        String
  date        DateTime
  author      User          @relation(fields: [userId], references: [id])
  isCurrent   Boolean
  userId      String
  order       Json
  fullprogram FullProgram[]
}

model FullProgram {
  id        String    @id @default(cuid())
  date      DateTime
  programs  Program[]
  author    User      @relation(fields: [userId], references: [id])
  isCurrent Boolean
  userId    String
}
