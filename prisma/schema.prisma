// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// url: what the app uses (in production, Neon's pooled connection).
// directUrl: what Prisma Migrate uses. Migrations need a direct, non-pooled
// connection: the pooler runs in transaction mode, which breaks migrate's
// session-level advisory lock.
datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// NextAuth schema
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  age           Int?
  bio           String?
  role          Role          @default(viewer)
  accounts      Account[]
  sessions      Session[]
  programs      Program[]
  fullprograms  FullProgram[]
}

// viewer: read-only (default for anyone who signs in)
// editor: creates services and songs, edits/deletes their own services
// admin: everything editors can, on any service
enum Role {
  viewer
  editor
  admin
}

model Song {
  id       String     @id @default(cuid())
  name     String
  type     String
  number   String?
  dates    DateTime[]
  programs Program[]
}

model Program {
  id          String        @id @default(cuid())
  songs       Song[]
  type        String
  date        DateTime
  author      User          @relation(fields: [userId], references: [id])
  isCurrent   Boolean
  userId      String
  order       Json
  fullprogram FullProgram[]
}

model FullProgram {
  id        String    @id @default(cuid())
  date      DateTime
  programs  Program[]
  author    User      @relation(fields: [userId], references: [id])
  isCurrent Boolean
  userId    String
}
